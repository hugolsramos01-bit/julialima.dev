---
import Icon from './Icon.astro';

const links = [
  { href: '/', label: 'Início' },
  { href: '/projetos', label: 'Projetos' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/contato', label: 'Contato' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Júlia Lima — início">
      <span class="brand-mark">JL</span>
      <span>Júlia Lima</span>
    </a>
    <nav class="site-nav" aria-label="Navegação principal">
      {links.map((link) => (
        <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="header-socials" aria-label="Perfis externos">
      <a href="https://github.com/JuliadBarros" rel="me" aria-label="GitHub de Júlia Lima"><Icon name="github" /></a>
      <a href="https://www.linkedin.com/in/juliadbarros/" rel="me" aria-label="LinkedIn de Júlia Lima"><Icon name="linkedin" /></a>
    </div>
  </div>
</header>
