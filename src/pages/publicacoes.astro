---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'Artigos de Júlia de Barros Lima, publicados nos anais do XV Congresso CONSAD de Gestão Pública: inteligência artificial e gestão patrimonial em Pernambuco.';
const proceedingsUrl = 'https://escola.egp.ce.gov.br/catalogo/1751';
const proceedingsBook = {
  '@type': 'Book',
  '@id': 'https://julialima.dev/publicacoes#anais-consad-2026',
  name: 'Anais do XV Congresso CONSAD de Gestão Pública',
  isbn: '978-65-976367-0-9',
  publisher: { '@type': 'Organization', name: 'Escola de Gestão Pública do Estado do Ceará (EGPCE)' },
  datePublished: '2026-07-01',
  url: proceedingsUrl,
};

const publications = [
  {
    id: 'inteligencia-artificial-gestao-patrimonial',
    number: '01',
    topic: 'Inteligência artificial · Gestão patrimonial',
    title: 'Inteligência artificial na gestão patrimonial pública: extração automatizada de dados não estruturados para apoio à decisão',
    authors: [
      'Emilio Fonseca Vieira',
      'Clóvis Allan Soares de Melo',
      'Hugo Leonardo dos Santos Ramos',
      'Júlia de Barros Lima',
    ],
    summary: 'Apresenta o Extractor, solução de IA para extração semântica de dados técnicos em laudos de avaliação imobiliária em Pernambuco, combinando processamento de linguagem natural e visão computacional. O resumo dos anais reporta redução superior a 90% no tempo de processamento.',
    session: '20 mai. 2026 · 16h',
    page: 'Anais, p. 72–73',
    presentation: '',
    keywords: ['Inteligência Artificial', 'Gestão Pública', 'Inovação Aberta', 'Extractor', 'Pernambuco'],
  },
  {
    id: 'gestao-bens-patrimoniais-moveis',
    number: '02',
    topic: 'Dados · Gestão patrimonial',
    title: 'Gestão estratégica e inovadora de bens patrimoniais móveis em larga escala',
    authors: [
      'Emilio Fonseca Vieira',
      'Júlia de Barros Lima',
      'Eridan Pereira Guimarães',
      'Tiago Henrique da Silva Gomes',
    ],
    summary: 'Estudo de caso do Acervo Móvel, camada gerencial complementar que reutiliza os dados oficiais do PE Integrado para consulta, filtragem, análise e exportação controlada. O resumo relata que, em um teste, o carregamento de uma visão consolidada caiu de 4 minutos e 18 segundos para 4 segundos.',
    session: '22 mai. 2026 · 8h10',
    page: 'Anais, p. 309–310',
    presentation: 'Apresentação no congresso feita por Eridan Guimarães, gestora da área de patrimônio móvel.',
    keywords: ['Gestão Patrimonial', 'Setor Público', 'Bens Móveis', 'Governo Digital', 'Acervo Móvel'],
  },
];

const person = {
  '@type': 'Person',
  '@id': 'https://julialima.dev/#julia-lima',
  name: 'Júlia Lima',
  alternateName: 'Júlia de Barros Lima',
  url: 'https://julialima.dev/',
  sameAs: ['https://www.linkedin.com/in/juliadbarros/', 'https://github.com/JuliadBarros'],
};

const publicationsSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://julialima.dev/publicacoes#pagina',
  url: 'https://julialima.dev/publicacoes',
  name: 'Publicações de Júlia de Barros Lima',
  description,
  inLanguage: 'pt-BR',
  about: { '@id': person['@id'] },
  mainEntity: {
    '@type': 'ItemList',
    name: 'Artigos nos Anais do XV Congresso CONSAD',
    numberOfItems: publications.length,
    itemListElement: publications.map((publication, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'ScholarlyArticle',
        '@id': `https://julialima.dev/publicacoes#${publication.id}`,
        headline: publication.title,
        author: publication.authors.map((author) => author === 'Júlia de Barros Lima'
          ? person
          : { '@type': 'Person', name: author }),
        isPartOf: proceedingsBook,
        pageStart: publication.page.match(/\d+/)?.[0],
        keywords: publication.keywords,
      },
    })),
  },
};
---

<BaseLayout title="Publicações — Júlia de Barros Lima | CONSAD" description={description} jsonLd={publicationsSchema}>
  <header class="page-header">
    <div class="container">
      <p class="eyebrow">Publicações</p>
      <h1>Pesquisa aplicada à gestão pública.</h1>
      <p>Artigos sobre dados, inteligência artificial e gestão patrimonial desenvolvidos em Pernambuco e apresentados no XV Congresso CONSAD.</p>
    </div>
  </header>

  <section class="section publications-section" aria-labelledby="consad-heading">
    <div class="container">
      <div class="publication-context">
        <p class="section-kicker">XV Congresso CONSAD · 2026</p>
        <h2 id="consad-heading">Anais de gestão pública</h2>
        <p>Nos Anais, a autoria aparece como <strong>Júlia de Barros Lima</strong>. Os resumos integram a coletânea publicada pela EGPCE, que reúne trabalhos apresentados no congresso.</p>
        <a class="inline-link" href={proceedingsUrl} target="_blank" rel="noopener noreferrer">Registro oficial da publicação dos Anais (EGPCE) <span aria-hidden="true">↗</span></a>
      </div>

      <div class="publication-list">
        {publications.map((publication) => (
          <article class="publication-item" id={publication.id}>
            <div class="publication-marker" aria-hidden="true">{publication.number}</div>
            <div class="publication-body">
              <p class="publication-topic">{publication.topic}</p>
              <h3>{publication.title}</h3>
              <p class="publication-authors"><span>Autoria</span>{publication.authors.join(' · ')}</p>
              <p class="publication-summary">{publication.summary}</p>
              {publication.presentation && <p class="presentation-note">{publication.presentation}</p>}
              <div class="publication-meta">
                <span>{publication.session}</span>
                <span>{publication.page}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .publications-section { background: var(--surface); }
  .publication-context { max-width: 760px; margin: 0 0 3rem auto; }
  .publication-context h2 { margin: 0; font-size: clamp(1.65rem, 3vw, 2.4rem); line-height: 1.12; letter-spacing: -.045em; }
  .publication-context > p:not(.section-kicker) { max-width: 690px; margin: 1rem 0; color: var(--ink-soft); }
  .publication-context strong { color: var(--ink); }
  .publication-list { border-top: 1px solid var(--line); }
  .publication-item { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 2.5rem; padding: 2.7rem 0; border-bottom: 1px solid var(--line); scroll-margin-top: 100px; }
  .publication-marker { color: var(--blue); font: 750 3.1rem/.95 "SFMono-Regular", Consolas, monospace; letter-spacing: -.1em; }
  .publication-body { max-width: 820px; }
  .publication-topic { margin: 0 0 .8rem; color: var(--green); font: 650 .72rem/1.3 "SFMono-Regular", Consolas, monospace; letter-spacing: .06em; text-transform: uppercase; }
  .publication-body h3 { margin: 0; font-size: clamp(1.45rem, 2.5vw, 2.15rem); line-height: 1.14; letter-spacing: -.045em; }
  .publication-authors { margin: 1rem 0; color: var(--ink-soft); font-size: .93rem; }
  .publication-authors span { display: block; margin-bottom: .25rem; color: var(--muted); font: 650 .68rem/1.3 "SFMono-Regular", Consolas, monospace; letter-spacing: .07em; text-transform: uppercase; }
  .publication-summary { max-width: 760px; margin: 1.2rem 0; color: var(--ink-soft); }
  .publication-meta { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; margin: 1rem 0; color: var(--muted); font: 600 .75rem/1.4 "SFMono-Regular", Consolas, monospace; }
  .publication-source { display: inline-flex; align-items: center; gap: .35rem; color: var(--blue); font-weight: 720; text-decoration: none; }
  .publication-source span { transition: transform 160ms ease; }
  .publication-source:hover span { transform: translate(3px, -3px); }
  @media (max-width: 760px) {
    .publication-context { margin: 0 0 2.5rem; }
    .publication-item { grid-template-columns: 1fr; gap: .9rem; padding: 2rem 0; }
    .publication-marker { font-size: 2rem; }
  }
</style>
